#!/bin/bash
# Maintenance tools launcher for The Batch Compendium
# This script provides easy access to maintenance and repository management tools

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="${REPO_ROOT}/z.repo_support/scripts"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

show_help() {
    echo -e "${BLUE}The Batch Compendium - Maintenance Tools${NC}"
    echo -e "${BLUE}=======================================${NC}"
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Available commands:"
    echo ""
    echo -e "  ${GREEN}find-repos${NC}      Find and discover new batch repositories"
    echo -e "                   Usage: $0 find-repos [--min-stars N] [--max-results N]"
    echo ""
    echo -e "  ${GREEN}update-count${NC}    Update the batch script count in README.md"
    echo -e "                   Usage: $0 update-count"
    echo ""
    echo -e "  ${GREEN}update-desc${NC}     Update GitHub repository description"
    echo -e "                   Usage: $0 update-desc"
    echo ""
    echo -e "  ${GREEN}add-topics${NC}      Add topics/tags to the GitHub repository"
    echo -e "                   Usage: $0 add-topics"
    echo ""
    echo -e "  ${GREEN}scripts-dir${NC}     Open the scripts directory"
    echo -e "                   Usage: $0 scripts-dir"
    echo ""
    echo -e "  ${GREEN}help${NC}            Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 find-repos --min-stars 100 --max-results 50"
    echo "  $0 update-count"
    echo "  $0 help"
    echo ""
    echo -e "${YELLOW}Note: All scripts are located in z.repo_support/scripts/${NC}"
}

case "$1" in
    "find-repos")
        shift
        echo -e "${BLUE}🔍 Finding batch repositories...${NC}"
        "${SCRIPTS_DIR}/find_batch_repos.sh" "$@"
        ;;
    "update-count")
        echo -e "${BLUE}📊 Updating script count...${NC}"
        "${SCRIPTS_DIR}/update_script_count.sh"
        ;;
    "update-desc")
        echo -e "${BLUE}📝 Updating repository description...${NC}"
        "${SCRIPTS_DIR}/update_description.sh"
        ;;
    "add-topics")
        echo -e "${BLUE}🏷️ Adding repository topics...${NC}"
        "${SCRIPTS_DIR}/add_topics.sh"
        ;;
    "scripts-dir")
        echo -e "${BLUE}📂 Scripts directory: ${SCRIPTS_DIR}${NC}"
        if command -v code &> /dev/null; then
            code "${SCRIPTS_DIR}"
        else
            echo "Available scripts:"
            ls -la "${SCRIPTS_DIR}/" | grep -E "\.(sh|py)$"
        fi
        ;;
    "help"|"-h"|"--help"|"")
        show_help
        ;;
    *)
        echo -e "${RED}❌ Unknown command: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac